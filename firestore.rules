rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(classId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid;
    }

    match /classes/{classId} {
      // 학부모가 로그인 없이 제출 페이지에서 학급 이름을 읽을 수 있어야 하므로 read는 공개.
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(classId);

      match /students/{studentId} {
        // 학부모가 본인 자녀 이름을 목록에서 선택해야 하므로 read는 공개.
        allow read: if true;
        allow write: if isOwner(classId);
      }

      match /meta/{docId} {
        // 결석계 양식 레이아웃은 학부모 브라우저에서 PDF를 채울 때 필요하므로 read는 공개.
        allow read: if true;
        allow write: if isOwner(classId);
      }

      match /absences/{absenceId} {
        // 결석 사유·서명 등은 민감정보이므로 열람은 담임 교사만 가능.
        // 학부모는 로그인 없이 제출(create)만 할 수 있고, 자신이 쓴 기록도 다시 읽지 못한다.
        allow read: if isOwner(classId);
        allow create: if request.resource.data.studentId is string &&
                         request.resource.data.status in ['서류대기', '제출완료'];
        allow update, delete: if isOwner(classId);
      }
    }
  }
}
