rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Firestore의 classes/{classId} 문서를 들여다봐서, 지금 로그인한 사람이
    // 그 학급을 만든 교사(ownerId)와 같은 사람인지 확인한다.
    // firestore.rules의 isOwner(classId)와 동일한 검사를 Storage 쪽에도 적용하기 위한 함수.
    function isClassOwner(classId) {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/classes/$(classId)).data.ownerId == request.auth.uid;
    }

    // 결석계 빈 양식: 학부모 브라우저가 채워 넣기 위해 내려받아야 하므로 읽기는 공개, 업로드는 그 반 담임만.
    match /templates/{classId}/{fileName} {
      allow read: if true;
      allow write: if isClassOwner(classId) &&
                      request.resource.size < 20 * 1024 * 1024 &&
                      request.resource.contentType == 'application/pdf';
    }

    // 완성된 결석계 PDF: 학부모가 업로드(로그인 없음), 그 반 담임만 열람/삭제.
    match /submissions/{classId}/{fileName} {
      allow read: if isClassOwner(classId);
      allow write: if request.resource.size < 20 * 1024 * 1024 &&
                      request.resource.contentType == 'application/pdf';
      allow delete: if isClassOwner(classId);
    }

    // 증빙서류 사진 첨부: 학부모가 업로드, 그 반 담임만 열람/삭제.
    match /photos/{classId}/{fileName} {
      allow read: if isClassOwner(classId);
      allow write: if request.resource.size < 10 * 1024 * 1024 &&
                      request.resource.contentType.matches('image/.*');
      allow delete: if isClassOwner(classId);
    }

    // 담임 서명(도장) 이미지: 그 반 담임만 업로드·열람 가능.
    match /signatures/{classId}/{fileName} {
      allow read: if isClassOwner(classId);
      allow write: if isClassOwner(classId) && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
