rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(classId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/classes/$(classId)).data.ownerId == request.auth.uid;
    }

    // 학부모가 "학급 이름 + 비밀번호"로 조합한 문서 ID를 정확히 알아야만 get이 성공한다.
    // list(목록 조회)는 막아서 이름/비밀번호 없이 다른 학급 정보를 훑어볼 수 없게 한다.
    match /classLookup/{lookupId} {
      allow get: if true;
      allow list: if false;
      allow write: if request.auth != null;
    }

    match /classes/{classId} {
      // 학부모가 로그인 없이 제출 페이지에서 학급 이름을 읽어야 하므로 단건 조회(get)는 공개.
      // 목록 조회(list)는 본인 학급만 가능하게 제한해서 다른 교사의 이메일 등이 노출되지 않게 한다.
      allow get: if true;
      allow list: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(classId);

      match /private/{docId} {
        // 학부모용 비밀번호 원문 등 교사 본인만 봐야 하는 설정값.
        allow read, write: if isOwner(classId);
      }

      match /students/{studentId} {
        // 학부모가 본인 자녀 이름을 목록에서 선택해야 하므로 read는 공개.
        allow read: if true;
        allow write: if isOwner(classId);
      }

      match /templates/{docType} {
        // 서류 양식 레이아웃은 학부모 브라우저에서 PDF를 채울 때 필요하므로 read는 공개.
        allow read: if true;
        allow write: if isOwner(classId);
      }

      match /records/{recordId} {
        // 결석/체험학습 사유·서명 등은 민감정보이므로 열람은 담임 교사만 가능.
        // 학부모는 로그인 없이 제출(create)만 할 수 있고, 자신이 쓴 기록도 다시 읽지 못한다.
        allow read: if isOwner(classId);
        allow create: if request.resource.data.studentId is string &&
                         request.resource.data.status in ['서류대기', '제출완료'];
        allow update, delete: if isOwner(classId);
      }
    }
  }
}
